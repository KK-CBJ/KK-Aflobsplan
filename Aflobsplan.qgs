        <defaultAction value="{00000000-0000-0000-0000-000000000000}" key="Canvas"/>
        <actionsetting action="''' IMPORT PLAN '''&#xd;&#xa;''' Genindlæs baggrundskort (Alle aktive planer) '''&#xd;&#xa;import psycopg2&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Import&#xd;&#xa;    dbSql = f'''&#xd;&#xa;        DO $BODY$&#xd;&#xa;&#xd;&#xa;        DECLARE&#xd;&#xa;&#xd;&#xa;            i record;&#xd;&#xa;&#xd;&#xa;        BEGIN&#xd;&#xa;&#xd;&#xa;            FOR i IN&#xd;&#xa;                SELECT&#xd;&#xa;                    guid&#xd;&#xa;                FROM aflob_plan.v_planer p&#xd;&#xa;                WHERE p.selected_ = 1&#xd;&#xa;            LOOP&#xd;&#xa;&#xd;&#xa;                PERFORM aflob_plan.import_clear(i.guid, 1);&#xd;&#xa;                PERFORM aflob_plan.import(i.guid, 1);&#xd;&#xa;&#xd;&#xa;            END LOOP;&#xd;&#xa;&#xd;&#xa;        END $BODY$;&#xd;&#xa;            '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Baggrundskort genindlæst&quot;, None, level=Qgis.Info, duration=5)&#xd;&#xa;&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_label_p_e8a0dbd4_6dea_435c_900c_cafc7649481a').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_p_dabb84da_274c_4c97_9ff1_e636630e5f13').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_l_e5df8fb3_9087_46b1_8b50_fac9244496ba').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_a_9c1e6f6d_e4a0_4e2c_a6c1_df13e8c172c0').reload()&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()&#xd;&#xa;" isEnabledOnlyWhenEditable="0" name="Genindlæs baggrundskort (Alle aktive planer)" type="1" icon="" id="{a3b7507c-66ae-45ec-bf87-912f4d8abdfb}" shortTitle="Genindlæs baggrundskort (Alle aktive planer)" capture="0" notificationMessage="">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="''' IMPORT PLAN '''&#xd;&#xa;''' Genindlæs planer (Alle aktive planer) '''&#xd;&#xa;import psycopg2&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Import&#xd;&#xa;    dbSql = f'''&#xd;&#xa;        DO $BODY$&#xd;&#xa;&#xd;&#xa;        DECLARE&#xd;&#xa;&#xd;&#xa;            i record;&#xd;&#xa;&#xd;&#xa;        BEGIN&#xd;&#xa;&#xd;&#xa;            FOR i IN&#xd;&#xa;                SELECT&#xd;&#xa;                    guid&#xd;&#xa;                FROM aflob_plan.v_planer p&#xd;&#xa;                WHERE p.selected_ = 1&#xd;&#xa;            LOOP&#xd;&#xa;&#xd;&#xa;                PERFORM aflob_plan.import_clear(i.guid);&#xd;&#xa;                PERFORM aflob_plan.import(i.guid);&#xd;&#xa;&#xd;&#xa;            END LOOP;&#xd;&#xa;&#xd;&#xa;        END $BODY$;&#xd;&#xa;            '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Planer genindlæst&quot;, None, level=Qgis.Info, duration=5)&#xd;&#xa;&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_label_p_077883b3_e42a_418a_a78a_c0561185d65e').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_p_d0ba31a3_d4c1_42ad_b1e4_a14a3d62cda1').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_l_1b02850b_0a3e_4a67_ae18_e6b0ecc5ef8c').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_a_1e141cee_f051_48c8_bf70_d40a3bb2b373').reload()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()&#xd;&#xa;" isEnabledOnlyWhenEditable="0" name="Genindlæs planer (Alle aktive planer)" type="1" icon="" id="{a187f3a2-b98f-4d54-8ff8-27353e245ea6}" shortTitle="Genindlæs planer (Alle aktive planer)" capture="0" notificationMessage="">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="''' IMPORT PLAN BAGGRUNDSKORT BULK '''&#xd;&#xa;''' Genindlæs planer og baggrundskort (Alle aktive planer) '''&#xd;&#xa;import psycopg2&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Import&#xd;&#xa;    dbSql = f'''&#xd;&#xa;        DO $BODY$&#xd;&#xa;&#xd;&#xa;        DECLARE&#xd;&#xa;&#xd;&#xa;            i record;&#xd;&#xa;&#xd;&#xa;        BEGIN&#xd;&#xa;&#xd;&#xa;            FOR i IN&#xd;&#xa;                SELECT&#xd;&#xa;                    guid&#xd;&#xa;                FROM aflob_plan.v_planer p&#xd;&#xa;                WHERE p.selected_ = 1&#xd;&#xa;            LOOP&#xd;&#xa;&#xd;&#xa;                PERFORM aflob_plan.import_clear(i.guid, 1);&#xd;&#xa;                PERFORM aflob_plan.import_clear(i.guid);&#xd;&#xa;                PERFORM aflob_plan.import(i.guid, 1);&#xd;&#xa;                PERFORM aflob_plan.import(i.guid);&#xd;&#xa;&#xd;&#xa;            END LOOP;&#xd;&#xa;&#xd;&#xa;        END $BODY$;&#xd;&#xa;            '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Planer og baggrundskort genindlæst&quot;, None, level=Qgis.Info, duration=5)&#xd;&#xa;&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_label_p_077883b3_e42a_418a_a78a_c0561185d65e').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_p_d0ba31a3_d4c1_42ad_b1e4_a14a3d62cda1').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_l_1b02850b_0a3e_4a67_ae18_e6b0ecc5ef8c').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_plan_a_1e141cee_f051_48c8_bf70_d40a3bb2b373').reload()&#xd;&#xa;&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_label_p_e8a0dbd4_6dea_435c_900c_cafc7649481a').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_p_dabb84da_274c_4c97_9ff1_e636630e5f13').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_l_e5df8fb3_9087_46b1_8b50_fac9244496ba').reload()&#xd;&#xa;    QgsProject.instance().mapLayer('plan_v_indhold_baggrundskort_a_9c1e6f6d_e4a0_4e2c_a6c1_df13e8c172c0').reload()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()&#xd;&#xa;" isEnabledOnlyWhenEditable="0" name="Genindlæs planer og baggrundskort (Alle aktive planer)" type="1" icon="" id="{916bb232-ad02-4fe8-9b75-d07b82e1ee9c}" shortTitle="Genindlæs planer og baggrundskort (Alle aktive planer)" capture="0" notificationMessage="">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="''' RENAME NODES BULK '''&#xd;&#xa;''' Omdøb knuder (Alle aktive planer) '''&#xd;&#xa;import psycopg2&#xd;&#xa;import os&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;planSelected_ = 1&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;if not planSelected_ == 1:&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Planen er ikke aktiveret&quot;, None, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;else:&#xd;&#xa;&#xd;&#xa;    dbConnection = psycopg2.connect(&#xd;&#xa;        host=layerUriHost&#xd;&#xa;        ,port=layerUriPort&#xd;&#xa;        ,database=layerUriDatabase&#xd;&#xa;        ,user=layerUriUser&#xd;&#xa;        ,password=layerUriPw&#xd;&#xa;    )&#xd;&#xa;&#xd;&#xa;    dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    try:&#xd;&#xa;        # Selected plans&#xd;&#xa;        dbSql = rf'''&#xd;&#xa;            WITH&#xd;&#xa;&#xd;&#xa;                cte1 AS(&#xd;&#xa;                    SELECT DISTINCT&#xd;&#xa;                        i.aflob_guid&#xd;&#xa;                        ,k.guid&#xd;&#xa;                    FROM aflob_plan.f_indhold_p i&#xd;&#xa;                    INNER JOIN aflob_plan.v_planer p ON p.guid = i.plan_guid&#xd;&#xa;                        AND p.selected_ = 1&#xd;&#xa;                    LEFT JOIN aflob.f_knuder_p k ON k.guid = i.aflob_guid&#xd;&#xa;                    WHERE i.aflob_tbl = 'f_knuder_p'&#xd;&#xa;                        AND COALESCE(k.navn, i.aflob_navn) !~* '^KK\d+$|^\d+$'&#xd;&#xa;                        AND (&#xd;&#xa;                            k.guid IS NOT NULL&#xd;&#xa;                            OR i.label_show IS DISTINCT FROM 0&#xd;&#xa;                        )&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;                ,upt_kn AS(&#xd;&#xa;                    UPDATE aflob.f_knuder_p k&#xd;&#xa;                        SET&#xd;&#xa;                            navn = NULL&#xd;&#xa;                    FROM cte1 c&#xd;&#xa;                    WHERE k.guid = c.guid&#xd;&#xa;                    RETURNING k.guid, k.navn&#xd;&#xa;&#xd;&#xa;            --        SELECT&#xd;&#xa;            --            k.guid&#xd;&#xa;            --            ,'KK851' || ROW_NUMBER() OVER() AS navn&#xd;&#xa;            --        FROM cte1 c&#xd;&#xa;            --            ,aflob.f_knuder_p k&#xd;&#xa;            --        WHERE k.guid = c.guid&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;                ,upt_lbl_1 AS(&#xd;&#xa;                    UPDATE aflob_plan.f_indhold_p i&#xd;&#xa;                        SET&#xd;&#xa;                            label = regexp_replace(label, '(^|\s|\n)' || i.aflob_navn || '($|\s|\n)', '\1' || k.navn ||'\2', 'g')&#xd;&#xa;                            ,aflob_navn = k.navn&#xd;&#xa;                    FROM upt_kn k&#xd;&#xa;                    WHERE i.aflob_guid = k.guid&#xd;&#xa;                    RETURNING aflob_guid&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;                ,upt_lbl_2 AS(&#xd;&#xa;                    UPDATE aflob_plan.f_indhold_p i&#xd;&#xa;                        SET&#xd;&#xa;                            label_show = 0&#xd;&#xa;                    FROM cte1 c&#xd;&#xa;                    WHERE i.aflob_guid = c.aflob_guid&#xd;&#xa;                        AND c.guid IS NULL&#xd;&#xa;                        AND i.label_show IS DISTINCT FROM 0&#xd;&#xa;                    RETURNING i.aflob_guid&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            SELECT&#xd;&#xa;                SUM(ct_)&#xd;&#xa;            FROM (&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;SELECT&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;COUNT(*) AS ct_&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;FROM upt_lbl_1&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;UNION ALL&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;SELECT&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;COUNT(*) AS ct_&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;FROM upt_lbl_2&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;) a;&#xd;&#xa;                '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        dbCursor.execute(dbSql)&#xd;&#xa;        dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        dbResult = dbCursor.fetchone()&#xd;&#xa;        dbResultCount = dbResult[0]&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Knuder omdøbt&quot;, str(dbResultCount), level=Qgis.Info, duration=5)&#xd;&#xa;        iface.mapCanvas().refreshAllLayers()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    except psycopg2.Error as e:&#xd;&#xa;        print(e.pgerror)&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    finally:&#xd;&#xa;        dbCursor.close()&#xd;&#xa;        dbConnection.close()" isEnabledOnlyWhenEditable="0" name="Omdøb knuder (Alle aktive planer)" type="1" icon="" id="{bf071040-c396-44ab-9825-e33e9e1102d9}" shortTitle="Omdøb knuder (Alle aktive planer)" capture="0" notificationMessage="">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="''' PLAN EXPORT DXF BULK '''&#xd;&#xa;''' Eksportér til DXF (Alle aktive planer) '''&#xd;&#xa;import psycopg2&#xd;&#xa;import os&#xd;&#xa;import processing&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;themeName = '03. Layout'&#xd;&#xa;&#xd;&#xa;themeLayers = []&#xd;&#xa;themeLayersOrdered = []&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;QgsExpressionContextUtils.setProjectVariable(QgsProject.instance(), 'dxf_export', '1')&#xd;&#xa;&#xd;&#xa;themeCollection = QgsProject.instance().mapThemeCollection()&#xd;&#xa;themeState = themeCollection.mapThemeState(themeName)&#xd;&#xa;&#xd;&#xa;# Visible layers in theme&#xd;&#xa;visibleThemes = [theme for theme in themeState.layerRecords() if theme.isVisible is True]&#xd;&#xa;&#xd;&#xa;# Convert visible themes to actual layer list&#xd;&#xa;for theme in visibleThemes:&#xd;&#xa;    themeLayers.append(theme.layer())&#xd;&#xa;&#xd;&#xa;# Use master layer order&#xd;&#xa;for layer in themeCollection.masterLayerOrder():&#xd;&#xa;    # If layer is present in theme, add to list&#xd;&#xa;    if layer in themeLayers:&#xd;&#xa;        themeLayersOrdered.append(layer)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Selected plans&#xd;&#xa;    dbSql = f'''&#xd;&#xa;        SELECT&#xd;&#xa;            guid&#xd;&#xa;            ,layout_map_scale_denom_calc&#xd;&#xa;            ,export_dxf_path_calc&#xd;&#xa;            ,filnavn_calc&#xd;&#xa;        FROM aflob_plan.v_planer&#xd;&#xa;        WHERE selected_ = 1&#xd;&#xa;            '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbResult = dbCursor.fetchall()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    if dbResult == []:&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Ingen aktive planer fundet&quot;, None, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;    # Plans found, continue&#xd;&#xa;    else:&#xd;&#xa;&#xd;&#xa;        for i in dbResult:&#xd;&#xa;&#xd;&#xa;            processingLayers = []&#xd;&#xa;            planOutput = None&#xd;&#xa;&#xd;&#xa;            planGuid = i[0]&#xd;&#xa;            planScale = i[1]&#xd;&#xa;            planOutputDir = i[2]&#xd;&#xa;            planOutputName = i[3]&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            # Use layer order&#xd;&#xa;            for layer in themeLayersOrdered:&#xd;&#xa;&#xd;&#xa;                # Set subset&#xd;&#xa;                layer.setSubsetString(f'plan_guid = \'{planGuid}\'')&#xd;&#xa;&#xd;&#xa;                # Insert position 0 for correct order in output&#xd;&#xa;                processingLayers.insert(&#xd;&#xa;                    0&#xd;&#xa;                    ,{&#xd;&#xa;                        'layer': layer.dataProvider().uri().uri()&#xd;&#xa;                        ,'attributeIndex': -1&#xd;&#xa;                        ,'overriddenLayerName': ''&#xd;&#xa;                        ,'buildDataDefinedBlocks': True&#xd;&#xa;                        ,'dataDefinedBlocksMaximumNumberOfClasses': -1&#xd;&#xa;                    }&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            if planOutputDir == '' or not(os.path.exists(os.path.normpath(planOutputDir))):&#xd;&#xa;                planOutputDir = r'C:\tmp'&#xd;&#xa;                if not(os.path.exists(os.path.normpath(planOutputDir))):&#xd;&#xa;                    os.mkdir(os.path.normpath(planOutputDir))&#xd;&#xa;&#xd;&#xa;            if not(os.path.exists(os.path.normpath(planOutputDir))):&#xd;&#xa;                iface.messageBar().pushMessage(&quot;Mappe kan ikke findes&quot;, planOutputDir, level=Qgis.Warning)&#xd;&#xa;            else:&#xd;&#xa;                planOutput = f'{planOutputDir}\{planOutputName}.dxf'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;                processing.run(&#xd;&#xa;                    &quot;native:dxfexport&quot;&#xd;&#xa;                    ,{&#xd;&#xa;                        'LAYERS':processingLayers&#xd;&#xa;                        ,'SYMBOLOGY_MODE':2&#xd;&#xa;                        ,'SYMBOLOGY_SCALE':planScale&#xd;&#xa;                        ,'MAP_THEME':themeName&#xd;&#xa;                        ,'ENCODING':'ISO-8859-1'&#xd;&#xa;                        ,'CRS':QgsCoordinateReferenceSystem('EPSG:25832')&#xd;&#xa;                        ,'EXTENT':None&#xd;&#xa;                        ,'SELECTED_FEATURES_ONLY':False&#xd;&#xa;                        ,'USE_LAYER_TITLE':False&#xd;&#xa;                        ,'FORCE_2D':False&#xd;&#xa;                        ,'MTEXT':True&#xd;&#xa;                        ,'EXPORT_LINES_WITH_ZERO_WIDTH':False&#xd;&#xa;                        ,'OUTPUT':os.path.normpath(planOutput)&#xd;&#xa;                    }&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        for layer in themeLayers:&#xd;&#xa;            layer.setSubsetString(None)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        QgsExpressionContextUtils.setProjectVariable(QgsProject.instance(), 'dxf_export', '0')&#xd;&#xa;&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Planer eksporteret til DXF&quot;, None, level=Qgis.Success, duration=5)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()" isEnabledOnlyWhenEditable="0" name="Eksportér til DXF (Alle aktive planer)" type="1" icon="" id="{9d934175-6383-4a6d-9667-31b0b57b58e1}" shortTitle="Eksportér til DXF (Alle aktive planer)" capture="0" notificationMessage="">
          <actionScope id="Feature"/>
        </actionsetting>
        <actionsetting action="''' PLAN EXPORT PDF BULK '''&#xd;&#xa;''' Eksportér til PDF (Alle aktive planer) '''&#xd;&#xa;import psycopg2&#xd;&#xa;import os&#xd;&#xa;import processing&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;themeName = '03. Layout'&#xd;&#xa;&#xd;&#xa;themeLayers = []&#xd;&#xa;&#xd;&#xa;planLayerId = 'plan_v_planer_98ef2aaa_6475_4343_8e09_0c46c1981431'&#xd;&#xa;atlasLayout = 'Atlas'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;themeCollection = QgsProject.instance().mapThemeCollection()&#xd;&#xa;themeState = themeCollection.mapThemeState(themeName)&#xd;&#xa;&#xd;&#xa;# Visible layers in theme&#xd;&#xa;visibleThemes = [theme for theme in themeState.layerRecords() if theme.isVisible is True]&#xd;&#xa;&#xd;&#xa;# Convert visible themes to actual layer list&#xd;&#xa;for theme in visibleThemes:&#xd;&#xa;    themeLayers.append(theme.layer())&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    # Prepare filter for Plan-layer&#xd;&#xa;    planLayer = QgsProject.instance().mapLayer(planLayerId)&#xd;&#xa;    if planLayer.isEditable():&#xd;&#xa;        planLayerEditable = 1&#xd;&#xa;        iface.vectorLayerTools().stopEditing(planLayer, False)&#xd;&#xa;    else:&#xd;&#xa;        planLayerEditable = 0&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Selected plans&#xd;&#xa;    dbSql = f'''&#xd;&#xa;        SELECT&#xd;&#xa;            guid&#xd;&#xa;            ,export_dxf_path_calc&#xd;&#xa;        FROM aflob_plan.v_planer&#xd;&#xa;        WHERE selected_ = 1&#xd;&#xa;            '''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbCursor.execute(dbSql)&#xd;&#xa;    dbConnection.commit()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    dbResult = dbCursor.fetchall()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;    if dbResult == []:&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Ingen aktive planer fundet&quot;, None, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;    # Plans found, continue&#xd;&#xa;    else:&#xd;&#xa;&#xd;&#xa;        for i in dbResult:&#xd;&#xa;&#xd;&#xa;            planOutput = None&#xd;&#xa;&#xd;&#xa;            planGuid = i[0]&#xd;&#xa;            planOutputDir = i[1]&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            planLayer.setSubsetString(f'guid = \'{planGuid}\'')&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            # Use layer theme&#xd;&#xa;            for layer in themeLayers:&#xd;&#xa;&#xd;&#xa;                # Set subset&#xd;&#xa;                layer.setSubsetString(f'plan_guid = \'{planGuid}\'')&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;            if planOutputDir == '' or not(os.path.exists(os.path.normpath(planOutputDir))):&#xd;&#xa;                planOutputDir = r'C:\tmp'&#xd;&#xa;                if not(os.path.exists(os.path.normpath(planOutputDir))):&#xd;&#xa;                    os.mkdir(os.path.normpath(planOutputDir))&#xd;&#xa;&#xd;&#xa;            if not(os.path.exists(os.path.normpath(planOutputDir))):&#xd;&#xa;                iface.messageBar().pushMessage(&quot;Mappe kan ikke findes&quot;, planOutputDir, level=Qgis.Warning)&#xd;&#xa;            else:&#xd;&#xa;                planOutput = f'{planOutputDir}'&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;                processing.run(&#xd;&#xa;                    &quot;native:atlaslayouttomultiplepdf&quot;&#xd;&#xa;                    ,{&#xd;&#xa;                        'LAYOUT':atlasLayout&#xd;&#xa;                        ,'COVERAGE_LAYER':None&#xd;&#xa;                        ,'FILTER_EXPRESSION':''&#xd;&#xa;                        ,'SORTBY_EXPRESSION':''&#xd;&#xa;                        ,'SORTBY_REVERSE':False&#xd;&#xa;                        ,'LAYERS':None&#xd;&#xa;                        ,'DPI':None&#xd;&#xa;                        ,'FORCE_VECTOR':False&#xd;&#xa;                        ,'FORCE_RASTER':False&#xd;&#xa;                        ,'GEOREFERENCE':True&#xd;&#xa;                        ,'INCLUDE_METADATA':True&#xd;&#xa;                        ,'DISABLE_TILED':False&#xd;&#xa;                        ,'SIMPLIFY':True&#xd;&#xa;                        ,'TEXT_FORMAT':0&#xd;&#xa;                        ,'IMAGE_COMPRESSION':0&#xd;&#xa;                        ,'OUTPUT_FILENAME':''&#xd;&#xa;                        ,'OUTPUT_FOLDER':os.path.normpath(planOutput)&#xd;&#xa;                    }&#xd;&#xa;                )&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        for layer in themeLayers:&#xd;&#xa;            layer.setSubsetString(None)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        # Filter Plan-layer&#xd;&#xa;        planLayer.setSubsetString(None)&#xd;&#xa;        if planLayerEditable == 1:&#xd;&#xa;            planLayer.startEditing()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;        iface.messageBar().pushMessage(&quot;Planer eksporteret til PDF&quot;, None, level=Qgis.Success, duration=5)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;except psycopg2.Error as e:&#xd;&#xa;    print(e.pgerror)&#xd;&#xa;    iface.messageBar().pushMessage(&quot;Fejl&quot;, e.pgerror, level=Qgis.Warning)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;finally:&#xd;&#xa;    dbCursor.close()&#xd;&#xa;    dbConnection.close()" isEnabledOnlyWhenEditable="0" name="Eksportér til PDF (Alle aktive planer)" type="1" icon="" id="{cdeba131-24f7-4df7-b520-427ea5a068d9}" shortTitle="Eksportér til PDF (Alle aktive planer)" capture="0" notificationMessage="">
          <actionScope id="Feature"/>
        </actionsetting>
      </attributeactions>

        <actionsetting action="''' PLAN ROTATE CANVAS '''&#xd;&#xa;''' Rotér kort '''&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;canvasRotation = -[%layout_rotation%]&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;iface.mapCanvas().setRotation(canvasRotation)&#xd;&#xa;iface.mapCanvas().refreshAllLayers()" isEnabledOnlyWhenEditable="0" name="Rotér kort" type="1" icon="" id="{05b87d8c-d082-489f-bb68-afd55aa908f0}" shortTitle="Rotér kort" capture="0" notificationMessage="">

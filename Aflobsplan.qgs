      <attributeactions>
        <defaultAction value="{00000000-0000-0000-0000-000000000000}" key="Canvas"/>
        <actionsetting action="''' PLAN ACTIVATION '''&#xd;&#xa;''' Aktivering af plan '''&#xd;&#xa;import psycopg2&#xd;&#xa;from qgis.utils import (&#xd;&#xa;    iface&#xd;&#xa;)&#xd;&#xa;from qgis.core import (&#xd;&#xa;    QgsProject&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' PARAMETER SETTINGS '''&#xd;&#xa;&#xd;&#xa;layerId = '[%@layer_id%]'&#xd;&#xa;planGuid = '[%guid%]'&#xd;&#xa;planAktivering = 1&#xd;&#xa;# 1: Aktivér kun denne plan&#xd;&#xa;# 2: Tilføj til aktive planer&#xd;&#xa;# 3: Deaktivér plan&#xd;&#xa;&#xd;&#xa;lstPlanAktivering = [&#xd;&#xa;        [&quot;planAktivering&quot;, &quot;Tekst&quot;]&#xd;&#xa;        ,[&quot;1&quot;, &quot;Plan aktiveret&quot;]&#xd;&#xa;        ,[&quot;2&quot;, &quot;Plan tilføjet til aktive planer&quot;]&#xd;&#xa;        ,[&quot;3&quot;, &quot;Plan deaktiveret&quot;]&#xd;&#xa;    ]&#xd;&#xa;&#xd;&#xa;layer = QgsProject.instance().mapLayer(layerId)&#xd;&#xa;layerUri = layer.dataProvider().uri()&#xd;&#xa;layerUriHost = layerUri.host()&#xd;&#xa;layerUriPort = layerUri.port()&#xd;&#xa;layerUriDatabase = layerUri.database()&#xd;&#xa;layerUriUser = (os.environ['USERNAME']).lower()&#xd;&#xa;layerUriPw = ''&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;''' START OF SCRIPT '''&#xd;&#xa;&#xd;&#xa;dbConnection = psycopg2.connect(&#xd;&#xa;    host=layerUriHost&#xd;&#xa;    ,port=layerUriPort&#xd;&#xa;    ,database=layerUriDatabase&#xd;&#xa;    ,user=layerUriUser&#xd;&#xa;    ,password=layerUriPw&#xd;&#xa;)&#xd;&#xa;&#xd;&#xa;dbCursor = dbConnection.cursor()&#xd;&#xa;&#xd;&#xa;&#xd;&#xa;try:&#xd;&#xa;    # Import&#xd;&#xa;    dbSql = f'''&#xd;&#xa;&#x9;&#x9;&#x9;UPDATE aflob_plan.v_lst_settings_user&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;SET&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;plan_guids = (&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;SELECT&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;array_agg(a.guid)::text&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;FROM (&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;SELECT&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9